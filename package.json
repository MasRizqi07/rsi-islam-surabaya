{
  "name": "rsi-islam-sby",
  "version": "2.0.0",
  "private": true,
  "description": "RS Islam Surabaya A. Yani - Konsep Hijau Tower (Portfolio Case Study)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.mjs\"",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:facts": "tsx scripts/check-facts.mjs",
    "validate:data": "tsx scripts/validate-data.mjs",
    "check:duplication": "node scripts/check-duplication.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo": "tsx scripts/reset-demo.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.16.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.5"
  }
}
